# Banco de dados PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=

# BravoPay - NUNCA use NEXT_PUBLIC_ aqui, esta chave é somente de servidor
BRAVOPAY_API_KEY=
BRAVOPAY_BASE_URL=https://bravopay.club/api/v1

# Segredo para assinar o cookie de sessão do admin (gere uma string aleatória longa)
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# URL pública do site (usada em metadata, OG, sitemap e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta (Facebook) Pixel + Conversions API
# ID do pixel — pode ser público, é usado no código do navegador
NEXT_PUBLIC_META_PIXEL_ID=
# Token de acesso da Conversions API — NUNCA use NEXT_PUBLIC aqui, é segredo de servidor
META_CONVERSIONS_API_TOKEN=
# Opcional: código de teste do Gerenciador de Eventos (aba "Testar eventos").
# Deixe em branco em produção, senão os eventos não contam para as campanhas.
META_TEST_EVENT_CODE=
