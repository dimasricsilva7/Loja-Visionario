generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
  FAILED
  CANCELED
}

enum FulfillmentStatus {
  AGUARDANDO_PAGAMENTO
  SEPARANDO
  ENVIADO
  SAIU_PARA_ENTREGA
  ENTREGUE
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  cpf          String
  phone        String
  cep          String?
  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders    Order[]
  favorites Favorite[]
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

model StoreSettings {
  id               String   @id @default("singleton")
  storeName        String   @default("Norte")
  logoUrl          String?
  heroImageUrl     String?
  heroImage2Url    String?
  heroImage3Url    String?
  marqueeLogo1Url  String?
  marqueeLogo2Url  String?
  shippingCents    Int      @default(0)
  currency         String   @default("BRL")
  offerCountdownMinutes Int @default(15)
  updatedAt        DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String
  priceCents        Int
  compareAtPriceCents Int?
  image             String
  images            String[] @default([])
  badge             String?
  badgeColor        String?
  stock             Int      @default(0)
  active            Boolean  @default(true)
  featured          Boolean  @default(false)
  sortOrder         Int      @default(0)
  categories        String[] @default(["Geral"])
  installments      Int      @default(1)
  productIdBravoPay String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderItems OrderItem[]
  favorites  Favorite[]

  relatedAsSource ProductRelation[] @relation("RelationSource")
  relatedAsTarget ProductRelation[] @relation("RelationTarget")

  @@index([active])
  @@index([featured])
  @@index([sortOrder])
}

model ProductRelation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation("RelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product @relation("RelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)
  sortOrder        Int     @default(0)

  @@unique([productId, relatedProductId])
  @@index([productId])
}

model Order {
  id                     String    @id @default(cuid())
  customerName           String
  customerEmail          String
  customerPhone          String
  customerCpf            String
  customerId             String?
  customer               Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderNumber            String?   @unique
  totalCents             Int
  shippingCents          Int       @default(0)
  status                 OrderStatus @default(PENDING)
  fulfillmentStatus      FulfillmentStatus @default(AGUARDANDO_PAGAMENTO)
  estimatedDeliveryDays  Int?
  externalReference      String    @unique
  bravopayTransactionId  String?   @unique
  pixCopyPaste           String?   @db.Text
  pixExpiresAt           DateTime?

  paymentPlan            String    @default("AVISTA")
  installmentCount       Int       @default(1)

  shippingCep            String?
  shippingAddress        String?
  shippingNumber         String?
  shippingComplement     String?
  shippingNeighborhood   String?
  shippingCity           String?
  shippingState          String?

  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  paidAt                 DateTime?
  updatedAt              DateTime  @updatedAt

  items        OrderItem[]
  transactions Transaction[]
  utm          UTMData?

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int     @default(1)
  unitPriceCents Int
  size           String?

  @@index([orderId])
  @@index([productId])
}

model Transaction {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bravopayId   String   @unique
  status       String
  method       String   @default("pix")
  amountCents  Int
  rawResponse  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
}

model WebhookEvent {
  id                 String   @id @default(cuid())
  eventKey           String   @unique
  event              String
  transactionId      String?
  externalReference  String?
  payload            Json
  processed          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([transactionId])
  @@index([event])
}

model UTMData {
  id       String  @id @default(cuid())
  orderId  String  @unique
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source   String?
  medium   String?
  campaign String?
  content  String?
  term     String?
  fbclid   String?
  ttclid   String?
  gclid    String?

  createdAt DateTime @default(now())
}
